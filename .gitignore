# Terraform 캐시
**/.terraform/

# Terraform State
*.tfstate
*.tfstate.*

# Terraform Plan 산출물
*.tfplan
tfplan

# 실제 환경 변수 값
*.tfvars
!*.tfvars.example

# Backend 실제 설정
backend.hcl
!backend.hcl.example

# 로컬 데이터 보호 검증 스택 (공용 DEV 승격 코드에는 포함하지 않음)
/terraform/environments/dev-data-test-aa/

# 환경 변수 및 Secret
.env
.env.*
*.pem
*.key

# Kubernetes 설정
kubeconfig
*.kubeconfig

# Destroy 전후 CNPG AWS Backup 증거 manifest
/.destroy-evidence/
/.restore-evidence/
# 실제 격리 검증 증거는 환경별 로컬 파일이며 인증정보를 포함할 수 있다.
/.stateful-qualification.json

# IDE
.vscode/
.idea/

# Python 검증 실행 산출물
__pycache__/
*.pyc

# Claude Code (팀 공유 안 함, 개인 로컬 설정)
.claude/

# OS
.DS_Store
Thumbs.db
