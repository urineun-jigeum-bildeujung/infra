            "metadata": [
              {
                "app_version": "v0.12.0",
                "chart": "prometheus-adapter",
                "first_deployed": 1789963051,
                "last_deployed": 1789963051,
                "name": "prometheus-adapter",
                "namespace": "monitoring",
                "notes": "prometheus-adapter has been deployed.\nIn a few minutes you should be able to list metrics using the following command(s):\n\n  kubectl get --raw /apis/custom.metrics.k8s.io/v1beta1\n\n",
                "revision": 1,
                "values": "{\"nodeSelector\":{\"node-role\":\"core\"},\"prometheus\":{\"port\":9090,\"url\":\"http://kube-prometheus-stack-prometheus.monitoring.svc\"},\"rules\":{\"custom\":[{\"metricsQuery\":\"sum(rate(\\u003c\\u003c.Series\\u003e\\u003e{\\u003c\\u003c.LabelMatchers\\u003e\\u003e}[2m])) by (\\u003c\\u003c.GroupBy\\u003e\\u003e)\",\"name\":{\"as\":\"${1}_per_second\",\"matches\":\"^(.*)_total$\"},\"resources\":{\"overrides\":{\"namespace\":{\"resource\":\"namespace\"},\"pod\":{\"resource\":\"pod\"}}},\"seriesQuery\":\"http_requests_total{namespace!=\\\"\\\",pod!=\\\"\\\"}\"}],\"default\":true}}",
                "version": "4.11.0"
              }
            ],
