            "values": [
              "\"nodeSelector\":\n  \"node-role\": \"core\"\n\"prometheus\":\n  \"port\": 9090\n  \"url\": \"http://kube-prometheus-stack-prometheus.monitoring.svc\"\n\"rules\":\n  \"custom\":\n  - \"metricsQuery\": \"sum(rate(\u003c\u003c.Series\u003e\u003e{\u003c\u003c.LabelMatchers\u003e\u003e}[2m])) by (\u003c\u003c.GroupBy\u003e\u003e)\"\n    \"name\":\n      \"as\": \"${1}_per_second\"\n      \"matches\": \"^(.*)_total$\"\n    \"resources\":\n      \"overrides\":\n        \"namespace\":\n          \"resource\": \"namespace\"\n        \"pod\":\n          \"resource\": \"pod\"\n    \"seriesQuery\": \"http_requests_total{namespace!=\\\"\\\",pod!=\\\"\\\"}\"\n  \"default\": true\n"
