# terraform-access 스택 tfvars 예시
# 실제 값은 terraform.tfvars 로 복사하여 사용하며, terraform.tfvars 는 Git 에 커밋하지 않는다.

aws_region        = "ap-northeast-2"
project_name      = "goljugaenyang"
state_bucket_name = "goljugaenyang-tfstate"

# GitHub Actions OIDC Role 을 신뢰할 GitHub 소유 조직 / 저장소
github_org  = "your-github-org"
github_repo = "infra"
