# Dev 환경 Terraform Remote Backend 설정 예시
# 실제 값은 backend.hcl 로 복사하여 사용하며, backend.hcl 은 Git 에 커밋하지 않는다.
#
# 초기화 예시:
#   terraform init -backend-config=backend.hcl

bucket       = "goljugaenyang-tfstate"
key          = "dev/terraform.tfstate"
region       = "ap-northeast-2"
encrypt      = true
use_lockfile = true
