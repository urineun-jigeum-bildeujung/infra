# Dev 환경 tfvars 예시 파일
# 실제 값은 terraform.tfvars 로 복사하여 사용하며, terraform.tfvars 는 Git 에 커밋하지 않는다.

aws_region   = "ap-northeast-2"
project_name = "petflow"
environment  = "dev"

# =============================================================================
# Network — 아키텍처 그림 기준 값
# =============================================================================
vpc_cidr = "10.0.0.0/16"

# 2 AZ 구성 (EKS 최소 요구사항 = 2 AZ)
# ⚠️ 노드 인스턴스 타입 c7i-flex.large 는 서울 리전에서 2b / 2d AZ 에서만 제공되어
#    2a / 2c 가 아닌 2b / 2d 를 사용한다. (확인: aws ec2 describe-instance-type-offerings)
azs = ["ap-northeast-2b", "ap-northeast-2d"]

# azs 순서와 매칭
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.20.0/24"]

# DEV 는 비용 절약을 위해 NAT Gateway 1개만 사용 (첫 번째 AZ 에 배치, 두 Private Subnet 이 공유)
# Prod 로 승격 시 false 로 변경 (AZ 마다 NAT 하나씩 → HA)
single_nat_gateway = true

# =============================================================================
# EKS
# =============================================================================
# EKS 버전. AWS 지원 버전 목록: aws eks describe-cluster-versions
# 초기 결정: 1.35
eks_cluster_version = "1.35"

# Endpoint 정책 — 초기엔 편의를 위해 Public 도 열고, Tailscale 연결 후 좁힌다.
#   1단계: public + private, cidrs=0.0.0.0/0        ← 현재
#   2단계: public + private, cidrs=[관리자 IP 목록]
#   최종:  private only, Tailscale 로만 접근
eks_endpoint_public_access  = true
eks_endpoint_private_access = true
eks_public_access_cidrs     = ["0.0.0.0/0"]

# Cluster Admin 권한을 부여할 IAM User/Role ARN.
# 담당자 IAM 사용자 하나만 우선 등록.
eks_cluster_admin_principal_arns = [
  "arn:aws:iam::297165773875:user/ujibil2",
]

# Managed Node Group
# ⚠️ 이 계정은 Free Tier eligible 인스턴스만 launch 가능하다 (t3.medium 등은 차단됨).
#    Free Tier eligible 중 EKS 노드로 실용적인 c7i-flex.large (2 vCPU / 4GB) 를 사용한다.
#    - t3.micro (1GB) 는 노드당 Pod 슬롯이 4개뿐이라 coredns / ebs-csi 가 스케줄되지 못함 (실측)
#    - c7i-flex.large 는 서울 리전 2b / 2d AZ 전용 → 위 azs 설정과 반드시 함께 유지
eks_node_instance_types = ["c7i-flex.large"]
eks_node_ami_type       = "AL2023_x86_64_STANDARD"
eks_node_desired_size   = 2
eks_node_min_size       = 1
eks_node_max_size       = 3

# =============================================================================
# S3 (애플리케이션용)
# =============================================================================
# 용도별로 <project>-<env>-<용도> 이름의 Bucket 이 생성된다.
# 예: petflow-dev-static / petflow-dev-product-images / petflow-dev-uploads
# 빈 Bucket 은 과금되지 않으며, 새 용도가 필요하면 목록에 추가만 하면 된다.
s3_bucket_purposes = ["static", "product-images", "uploads"]

# =============================================================================
# ECR
# =============================================================================
# Source of Truth: 백엔드 리포지토리(sever) dev 브랜치의 services/ 디렉터리.
# 실제 생성 이름은 <project_name>/<service_name> 형태 (예: petflow/auth-service).
# 백엔드에 새 서비스가 추가되면 이 목록에 이름만 추가한다 (기존 Repository 영향 없음).
ecr_repository_names = [
  "auth-service",
  "member-service",
  "order-service",
  "payment-service",
  "product-service",
]
